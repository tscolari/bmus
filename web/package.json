{
  "name": "bmus-console",
  "version": "0.1.0",
  "private": true,
  "description": "The bmus console's frontend, built into internal/console/assets.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node esbuild.config.mjs",
    "typecheck": "tsc --noEmit && tsc --noEmit -p e2e",
    "test": "vitest run",
    "e2e": "playwright test -c e2e"
  },
  "dependencies": {
    "preact": "^11.1.0"
  },
  "devDependencies": {
    "@fontsource/archivo-narrow": "^5.3.0",
    "@fontsource/space-mono": "^5.3.0",
    "@fontsource/syncopate": "^5.3.0",
    "@playwright/test": "1.64.1",
    "@types/node": "^22.20.5",
    "esbuild": "^0.28.2",
    "preact-render-to-string": "^6.8.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
